{
  "name": "dlintr",
  "version": "0.1.1",
  "type": "module",
  "description": "Dockerfile linter, validate inline bash, powered by hadolint with WASM",
  "repository": "git+https://github.com/wasmio/dlintr.git",
  "author": "JounQin (https://www.1stG.me) <admin@1stg.me>",
  "funding": "https://opencollective.com/unts",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.1.0"
  },
  "exports": "./src/index.ts",
  "files": [
    "ghc_wasm_jsffi.js",
    "hadolint.wasm",
    "lib",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:r": "r -f cjs",
    "build:tsc": "tsc -p src",
    "build:wasm": "node scripts/hadolint-wasm.mjs",
    "dev": "vitest",
    "docs:build": "vite build docs",
    "docs:dev": "vite docs",
    "lint": "run-p lint:*",
    "lint:es": "eslint . --cache -f friendly --max-warnings 10",
    "lint:style": "stylelint . --cache",
    "lint:tsc": "tsc --noEmit && tsc -p docs --noEmit",
    "lint:typecov": "type-coverage",
    "prepare": "simple-git-hooks",
    "prerelease": "pnpm build",
    "release": "changeset publish",
    "serve": "sirv dist -s",
    "pretest": "node scripts/hadolint-wasm.mjs",
    "test": "vitest run --coverage",
    "typecov": "type-coverage",
    "version": "changeset version",
    "postversion": "pnpm i --no-frozen-lockfile"
  },
  "dependencies": {
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@1stg/app-config": "^15.0.0",
    "@1stg/browserslist-config": "^2.1.4",
    "@1stg/commitlint-config": "^6.0.0",
    "@1stg/eslint-config": "^10.3.0",
    "@1stg/markuplint-config": "^4.0.7",
    "@1stg/nano-staged": "^0.3.1",
    "@1stg/prettier-config": "^5.4.0",
    "@1stg/remark-preset": "^3.2.0",
    "@1stg/simple-git-hooks": "^2.0.0",
    "@1stg/stylelint-config": "^6.2.0",
    "@1stg/tsconfig": "^4.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.3",
    "@eslint-react/eslint-plugin": ">=1.0.0",
    "@mdx-js/rollup": "^3.1.1",
    "@pkgr/rollup": "^7.0.0",
    "@types/mdx": "^2.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/eslint-plugin": "^1.0.0",
    "browserslist": "^4.28.2",
    "dlintr": "link:.",
    "eslint": "^10.0.0",
    "eslint-formatter-friendly": "^7.0.0",
    "eslint-plugin-react-hooks": ">=5.0.0",
    "github-markdown-css": "^5.1.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^5.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "simple-git-hooks": "^2.14.0",
    "sirv-cli": "^3.0.0",
    "size-limit": "^14.0.0",
    "size-limit-preset-node-lib": "^0.5.1",
    "stylelint": "^17.0.0",
    "type-coverage": "^2.22.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "main": "./lib/index.cjs",
    "module": "./lib/index.js",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "browser": "./lib/browser.js",
        "import": "./lib/index.js",
        "require": "./lib/index.cjs"
      },
      "./package.json": "./package.json"
    },
    "types": "./lib/index.d.ts"
  },
  "size-limit": [
    {
      "path": "lib/index.js"
    }
  ],
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreAsAssertion": true,
    "ignoreNonNullAssertion": true,
    "showRelativePath": true,
    "strict": true,
    "update": false
  }
}
